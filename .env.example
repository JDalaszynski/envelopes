# ─────────────────────────────────────────────────────────────
# Envelopes — zmienne środowiskowe (Vercel Environment Variables)
# Skopiuj do .env.local na potrzeby pracy lokalnej.
# Bez uzupełnienia tych wartości aplikacja działa w trybie
# DEV FALLBACK (dane w .data/, e-maile do konsoli) — patrz README.
# ─────────────────────────────────────────────────────────────

# ── Firebase (klient — publiczne, bezpieczne do ekspozycji) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (serwer — NIGDY po stronie klienta) ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Klucz prywatny w jednej linii, znaki nowej linii jako \n
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# ── Brevo (wyłącznie e-maile transakcyjne — sklep nie prowadzi newslettera) ──
BREVO_API_KEY=
BREVO_SENDER_EMAIL=kontakt@envelopes.pl
BREVO_SENDER_NAME=Koperty Envelopes

# ── Przelewy24 ──
P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC=
P24_API_KEY=
P24_SANDBOX=true

# ── InPost Geowidget ──
NEXT_PUBLIC_INPOST_GEOWIDGET_TOKEN=

# ── Pozostałe ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_BOOTSTRAP_EMAIL=kontakt@envelopes.pl
